{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WorkflowDiagnostic": {
      "properties": {
        "code": {
          "type": "string"
        },
        "level": {
          "$ref": "#/definitions/WorkflowDiagnosticLevel"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceScope": {
          "anyOf": [
            {
              "$ref": "#/definitions/WorkflowScope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "level",
        "message"
      ],
      "type": "object"
    },
    "WorkflowDiagnosticLevel": {
      "enum": [
        "warning",
        "error"
      ],
      "type": "string"
    },
    "WorkflowEngine": {
      "description": "Execution engine selected by a `zuno.workflow/v1` document.",
      "enum": [
        "graph/v1",
        "javascript/v1",
        "node-worker/v1"
      ],
      "type": "string"
    },
    "WorkflowScope": {
      "description": "Discovery authority that supplied a workflow. This is provenance, not a precedence promise; `workflowId` remains the opaque selector.",
      "enum": [
        "user",
        "project",
        "plugin"
      ],
      "type": "string"
    },
    "WorkflowSourceIdentity": {
      "description": "Immutable identity for one exact workflow source document.",
      "properties": {
        "digest": {
          "description": "SHA-256 digest of the exact source bytes.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source": {
          "description": "Human-readable source provenance, such as a path or plugin resource id.",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "digest",
        "name",
        "source",
        "version"
      ],
      "type": "object"
    },
    "WorkflowSummary": {
      "description": "A discovered and validated workflow. Zuno does not reserve names for built-in business workflows; every entry comes from a discoverable source.",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "engine": {
          "$ref": "#/definitions/WorkflowEngine"
        },
        "executableDigest": {
          "description": "Digest of all executable material. For `scriptFile` workflows this binds both the document and resolved script bytes.",
          "type": "string"
        },
        "identity": {
          "$ref": "#/definitions/WorkflowSourceIdentity"
        },
        "scope": {
          "$ref": "#/definitions/WorkflowScope"
        },
        "workflowId": {
          "description": "Opaque registry selector. Callers must not derive this from the name.",
          "type": "string"
        }
      },
      "required": [
        "engine",
        "executableDigest",
        "identity",
        "scope",
        "workflowId"
      ],
      "type": "object"
    }
  },
  "properties": {
    "diagnostics": {
      "default": [],
      "items": {
        "$ref": "#/definitions/WorkflowDiagnostic"
      },
      "type": "array"
    },
    "valid": {
      "type": "boolean"
    },
    "workflow": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkflowSummary"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "valid"
  ],
  "title": "WorkflowValidateResponse",
  "type": "object"
}