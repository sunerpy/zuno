load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "codex_rust_crate")
load("//bazel/platforms:release_binaries.bzl", "multiplatform_binaries")
load("//bazel/rules:e2e_benchmark.bzl", "codex_e2e_benchmark")

codex_rust_crate(
    name = "cli",
    binaries_with_build_commit = [
        "codex",
        "zuno",
    ],
    crate_name = "codex_cli",
    extra_binaries = [
        "//codex-rs/bwrap:bwrap",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob(["src/**/snapshots/**"]),
)

multiplatform_binaries(
    name = "codex",
)

# Zuno is the product binary. Keep Codex's release filegroup untouched so
# upstream release workflows remain replayable, and expose a separate group for
# Zuno's own candidate/release pipeline.
multiplatform_binaries(
    name = "zuno",
    filegroup_name = "zuno_release_binaries",
)

codex_e2e_benchmark(
    name = "codex-help",
    binaries = [":codex"],
)
