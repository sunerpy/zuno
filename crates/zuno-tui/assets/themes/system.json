{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ansiRed": { "dark": 9, "light": 1 },
    "ansiGreen": { "dark": 10, "light": 2 },
    "ansiYellow": { "dark": 11, "light": 3 },
    "ansiBlue": { "dark": 14, "light": 4 },
    "ansiMagenta": { "dark": 13, "light": 5 },
    "ansiCyan": { "dark": 14, "light": 6 },
    "ansiGreenBright": { "dark": 10, "light": 2 },
    "ansiRedBright": { "dark": 9, "light": 1 },
    "base": { "dark": "#0d0d0d", "light": "#f7f7f7" },
    "panel": { "dark": "#171717", "light": "#ededed" },
    "element": { "dark": "#212121", "light": "#e2e2e2" },
    "lineSubtle": { "dark": "#303030", "light": "#d0d0d0" },
    "line": { "dark": "#4d4d4d", "light": "#b0b0b0" },
    "lineActive": { "dark": "#7a7a7a", "light": "#808080" },
    "fg": { "dark": "#e6e6e6", "light": "#1f1f1f" },
    "fgMuted": { "dark": "#9a9a9a", "light": "#5f5f5f" },
    "diffAddedFill": { "dark": "#12261a", "light": "#e3f2e6" },
    "diffRemovedFill": { "dark": "#2a1416", "light": "#f7e2e3" },
    "diffAddedGutter": { "dark": "#1a3324", "light": "#d3e8d8" },
    "diffRemovedGutter": { "dark": "#3a1c1f", "light": "#efd3d5" }
  },
  "theme": {
    "primary": "ansiCyan",
    "secondary": "ansiMagenta",
    "accent": "ansiCyan",
    "error": "ansiRed",
    "warning": "ansiYellow",
    "success": "ansiGreen",
    "info": "ansiCyan",

    "text": "fg",
    "textMuted": "fgMuted",
    "selectedListItemText": "base",

    "background": "base",
    "backgroundPanel": "panel",
    "backgroundElement": "element",
    "backgroundMenu": "element",

    "borderSubtle": "lineSubtle",
    "border": "line",
    "borderActive": "lineActive",

    "diffAdded": "ansiGreen",
    "diffRemoved": "ansiRed",
    "diffContext": "fgMuted",
    "diffHunkHeader": "fgMuted",
    "diffHighlightAdded": "ansiGreenBright",
    "diffHighlightRemoved": "ansiRedBright",
    "diffAddedBg": "diffAddedFill",
    "diffRemovedBg": "diffRemovedFill",
    "diffContextBg": "panel",
    "diffLineNumber": "fgMuted",
    "diffAddedLineNumberBg": "diffAddedGutter",
    "diffRemovedLineNumberBg": "diffRemovedGutter",

    "markdownText": "fg",
    "markdownHeading": "fg",
    "markdownLink": "ansiBlue",
    "markdownLinkText": "ansiCyan",
    "markdownCode": "ansiGreen",
    "markdownBlockQuote": "ansiYellow",
    "markdownEmph": "ansiYellow",
    "markdownStrong": "fg",
    "markdownHorizontalRule": "line",
    "markdownListItem": "ansiBlue",
    "markdownListEnumeration": "ansiCyan",
    "markdownImage": "ansiBlue",
    "markdownImageText": "ansiCyan",
    "markdownCodeBlock": "fg",

    "syntaxComment": "fgMuted",
    "syntaxKeyword": "ansiMagenta",
    "syntaxFunction": "ansiBlue",
    "syntaxVariable": "fg",
    "syntaxString": "ansiGreen",
    "syntaxNumber": "ansiYellow",
    "syntaxType": "ansiCyan",
    "syntaxOperator": "ansiCyan",
    "syntaxPunctuation": "fg"
  }
}
