{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "adk-docs-mcp": {
      "command": [
        "uvx",
        "--from",
        "mcpdoc==0.0.10",
        "--with",
        "mcp[cli]==1.29.0",
        "mcpdoc",
        "--urls",
        "AgentDevelopmentKit:https://adk.dev/llms.txt",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "environment": {
        "HTTPS_PROXY": "http://127.0.0.1:1080",
        "HTTP_PROXY": "http://127.0.0.1:1080",
        "http_proxy": "http://127.0.0.1:1080",
        "https_proxy": "http://127.0.0.1:1080",
        "no_proxy": "onethinker.top,test-ai-api.nwcdcloud.cn,192.168.143.247,amazonaws.com.cn,localhost,127.0.0.1,18.179.104.237"
      },
      "type": "local"
    },
    "openai-developer-docs": {
      "enabled": true,
      "type": "remote",
      "url": "https://developers.openai.com/mcp"
    },
    "aws-knowledge-mcp-server": {
      "enabled": true,
      "type": "remote",
      "url": "https://knowledge-mcp.global.api.aws"
    },
    "chrome-devtools": {
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url=http://127.0.0.1:22306"
      ],
      "type": "local"
    },
    "codegraph-mcp-server": {
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "type": "local"
    },
    "canvas-authoring": {
      "command": [
        "dnx",
        "Microsoft.PowerApps.CanvasAuthoring.McpServer",
        "--yes",
        "--prerelease",
        "--source",
        "https://api.nuget.org/v3/index.json"
      ],
      "enabled": true,
      "type": "local"
    },
    "microsoft-learn": {
      "enabled": true,
      "type": "remote",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "quick-ticket": {
      "enabled": true,
      "headers": {
        "X-Authenticated-User-Email": "shaonanzhang@nwcdcloud.cn"
      },
      "type": "remote",
      "url": "http://localhost:18080/quick-ticket/mcp"
    }
  },
  "permission": {
    "lsp": "allow",
    "todoread": "allow",
    "todowrite": "allow"
  },
  "plugin": [
    "opencode-antigravity-auth@1.6.0",
    "@sunerpy/opencode-kiro-auth@0.18.0",
    "@sunerpy/oh-my-openagent@4.21.0"
  ],
