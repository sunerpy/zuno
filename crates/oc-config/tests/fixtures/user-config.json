    "awsopenai": {
      "models": {
        "openai.gpt-5.4": {
          "limit": {
            "context": 272000,
            "output": 65536
          },
          "name": "AWS OpenAI GPT-5.4",
          "options": {
            "reasoningEffort": "medium",
            "textVerbosity": "low"
