[
  { "id": "arguments-happy",            "template": "Input: $ARGUMENTS",                     "arguments": "extra args" },
  { "id": "arguments-empty",            "template": "Input: $ARGUMENTS",                     "arguments": "" },
  { "id": "arguments-whitespace-only",  "template": "Input: $ARGUMENTS",                     "arguments": "   " },
  { "id": "third-of-two",               "template": "A=[$1] B=[$2] C=[$3]",                  "arguments": "one two" },
  { "id": "third-of-two-plus-args",     "template": "A=[$1] B=[$2] C=[$3] ALL=[$ARGUMENTS]", "arguments": "one two" },
  { "id": "greedy-last-absorbs",        "template": "A=[$1] B=[$2]",                         "arguments": "one two three four" },
  { "id": "single-placeholder-greedy",  "template": "only: $1",                              "arguments": "one two three" },
  { "id": "descending-order",           "template": "B=[$2] A=[$1]",                         "arguments": "one two three" },
  { "id": "repeated-placeholder",       "template": "$1 and $1 and $2",                      "arguments": "x y z" },
  { "id": "gap-in-placeholders",        "template": "A=[$1] C=[$3]",                         "arguments": "one two three four" },
  { "id": "no-placeholder-with-args",   "template": "NO PLACEHOLDERS HERE",                  "arguments": "trailing input" },
  { "id": "no-placeholder-no-args",     "template": "NO PLACEHOLDERS HERE",                  "arguments": "" },
  { "id": "no-placeholder-blank-args",  "template": "NO PLACEHOLDERS HERE",                  "arguments": "  \t " },
  { "id": "tenth-placeholder",          "template": "T=[$10] ONE=[$1]",                      "arguments": "a b c d e f g h i j k" },
  { "id": "zero-placeholder",           "template": "Z=[$0] ONE=[$1]",                       "arguments": "one two" },
  { "id": "bare-dollar-amount",         "template": "COST IS $5.00 and $x and $",            "arguments": "one two" },
  { "id": "bare-dollar-no-args",        "template": "COST IS $5.00 and $x and $",            "arguments": "" },
  { "id": "double-quoted-token",        "template": "A=[$1] B=[$2]",                         "arguments": "\"hello world\" second" },
  { "id": "single-quoted-token",        "template": "A=[$1] B=[$2]",                         "arguments": "'hello world' second" },
  { "id": "image-token",                "template": "A=[$1] B=[$2]",                         "arguments": "[Image 3] caption" },
  { "id": "unbalanced-quote",           "template": "A=[$1] B=[$2]",                         "arguments": "\"unclosed second" },
  { "id": "lone-quote-token",           "template": "A=[$1] B=[$2]",                         "arguments": "\" second" },
  { "id": "collapsing-whitespace",      "template": "A=[$1] B=[$2] C=[$3]",                  "arguments": "one    two\tthree" },
  { "id": "arguments-raw-not-tokens",   "template": "P=[$1] ALL=[$ARGUMENTS]",               "arguments": "\"quoted arg\"  spaced" },
  { "id": "leading-trailing-trim",      "template": "   $ARGUMENTS   ",                      "arguments": "mid" },
  { "id": "trim-empties-template",      "template": "   $1   ",                              "arguments": "" },
  { "id": "placeholder-adjacent-text",  "template": "pre$1post",                             "arguments": "VAL" },
  { "id": "many-placeholders",          "template": "$1|$2|$3|$4|$5",                        "arguments": "a b" },
  { "id": "arguments-inside-word",      "template": "x$ARGUMENTSy",                          "arguments": "MID" },
  { "id": "multiline-template",         "template": "line1 $1\nline2 $2\nline3",             "arguments": "a b c" },
  { "id": "dollar-arguments-lowercase", "template": "$arguments and $ARGUMENTS",             "arguments": "up" },
  { "id": "big-number-placeholder",     "template": "$999",                                 "arguments": "a b" },
  { "id": "review-builtin-shape",       "template": "Input: $ARGUMENTS\n\nRun: `git show $ARGUMENTS`", "arguments": "abc123" },
  { "id": "hint-sort-lexicographic",    "template": "$2 and $10",                            "arguments": "a b c d e f g h i j k l" },
  { "id": "image-token-lowercase",      "template": "A=[$1] B=[$2]",                         "arguments": "[image 12] tail" },
  { "id": "image-token-only",           "template": "A=[$1]",                                "arguments": "[Image 12]" },
  { "id": "apostrophe-mid-token",       "template": "A=[$1] B=[$2]",                         "arguments": "don't stop" },
  { "id": "empty-template-with-args",   "template": "",                                      "arguments": "just this" },
  { "id": "empty-template-no-args",     "template": "",                                      "arguments": "" },
  { "id": "quoted-arguments-raw",       "template": "$ARGUMENTS",                            "arguments": "\"a b\"" },
  { "id": "escaped-dollar-digit-word",  "template": "$1a $2b",                               "arguments": "x y z" },
  { "id": "consecutive-placeholders",   "template": "$1$2$3",                                "arguments": "a b c d" },
  { "id": "newline-in-arguments",       "template": "A=[$1] ALL=[$ARGUMENTS]",               "arguments": "one\ntwo" },
  { "id": "unicode-arguments",          "template": "A=[$1] B=[$2]",                         "arguments": "日本語 テスト 三つ" },
  { "id": "unicode-arguments-only",     "template": "$ARGUMENTS",                            "arguments": "héllo wörld" },
  { "id": "zero-alone-with-args",       "template": "only: $0",                              "arguments": "a b c" },
  { "id": "zero-alone-no-args",         "template": "only: $0",                              "arguments": "" },
  { "id": "double-zero",                "template": "Z=[$00] ONE=[$1]",                       "arguments": "one two" },
  { "id": "leading-zero-placeholder",   "template": "A=[$01] B=[$2]",                        "arguments": "one two three" },
  { "id": "huge-number-placeholder",    "template": "$99999999999999999999",                 "arguments": "a b" },
  { "id": "non-ascii-digit-placeholder","template": "$\u0663 and $1",                        "arguments": "a b" },
  { "id": "arguments-then-numbered",    "template": "$ARGUMENTS then $1",                    "arguments": "a b" },
  { "id": "empty-quoted-token",         "template": "A=[$1] B=[$2]",                         "arguments": "\"\" second" },
  { "id": "dollar-dollar-in-arguments", "template": "ALL=[$ARGUMENTS]",                      "arguments": "cost $$ high" },
  { "id": "dollar-amp-in-arguments",    "template": "ALL=[$ARGUMENTS]",                      "arguments": "$& weird" },
  { "id": "dollar-backtick-arguments",  "template": "pre ALL=[$ARGUMENTS] post",             "arguments": "x $` y" },
  { "id": "dollar-quote-arguments",     "template": "pre ALL=[$ARGUMENTS] post",             "arguments": "x $' y" },
  { "id": "dollar-dollar-positional",   "template": "P=[$1]",                               "arguments": "$$ tail" },
  { "id": "dollar-amp-positional",      "template": "P=[$1] Q=[$2]",                        "arguments": "$& tail" }
]
